@startuml
' Sơ đồ lớp thiết kế tổng quát (Hình 82) — 7 package, chỉ hiển thị tên lớp; quan hệ từ khóa ngoại schema.
' Bỏ ReturnRequest/ReturnItem theo quyết định D3 (đổi trả ngoài phạm vi).
hide empty members
skinparam class {
  BackgroundColor<<chưa cài đặt>> #FFF3E0
}
title Sơ đồ lớp thiết kế tổng quát của hệ thống
package "1. User & Access Control" {
  class User
  class Role
  class Permission
  class UserRole
  class RolePermission
  class Employee
  class Customer
  class RefreshToken
  class CustomerAddress
}
package "2. Product Catalog" {
  class Category
  class Brand
  class Product
  class ProductVariant
  class ProductImage
  class Specification
}
package "3. Supplier & Warehouse" {
  class Supplier
  class Warehouse
  class GoodsReceipt
  class GoodsReceiptItem
  class GoodsReceiptItemDevice
  class GoodsReceiptItemDeviceImei
  class Inventory
  class SerialNumber
