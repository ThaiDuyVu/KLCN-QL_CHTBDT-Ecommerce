orders ||--o{ payments : order_id
products ||--o{ product_images : product_id
products ||--o| product_semantic_index : product_id
products ||--o{ product_variants : product_id
categories ||--o{ products : category_id
brands ||--o{ products : brand_id
promotions ||--o{ promotion_products : promotion_id
products ||--o{ promotion_products : product_id
users ||--o{ refresh_tokens : user_id
refresh_tokens |o--o{ refresh_tokens : replaced_by_token_id
serial_numbers |o--o{ return_items : serial_id
return_requests ||--o{ return_items : return_id
order_items ||--o{ return_items : order_item_id
orders ||--o{ return_requests : order_id
