employees |o--o{ return_requests : employee_id
customers ||--o{ reviews : customer_id
products ||--o{ reviews : product_id
order_items ||--o{ reviews : order_item_id
employees |o--o{ reviews : employee_id
roles ||--o{ role_permissions : role_id
permissions ||--o{ role_permissions : permission_id
product_variants ||--o{ serial_numbers : variant_id
warehouses ||--o{ serial_numbers : warehouse_id
orders ||--o{ shipments : order_id
employees ||--o{ shipments : employee_id
products ||--o{ specifications : product_id
users ||--o| user_roles : user_id
roles ||--o{ user_roles : role_id
serial_numbers ||--o| warranties : serial_id
order_items ||--o{ warranties : order_item_id
customers ||--o{ warranties : customer_id
warranties ||--o{ warranty_tickets : warranty_id
serial_numbers ||--o{ warranty_tickets : serial_id
