@startuml
' Hình 76. ERD tổng quát — 49 bảng, 75 khóa ngoại, sinh tự động từ schema thật
hide circle
hide members
skinparam linetype ortho
skinparam entity {
  BackgroundColor<<mới>> #E3F2FD
  BackgroundColor<<thiết kế sẵn>> #FFF3E0
}
package "ERD 01 — Người dùng và phân quyền" {
  entity "users" as users
  entity "roles" as roles
  entity "permissions" as permissions
  entity "user_roles" as user_roles
  entity "role_permissions" as role_permissions
  entity "employees" as employees
  entity "customers" as customers
  entity "refresh_tokens" as refresh_tokens <<mới>>
  entity "customer_addresses" as customer_addresses <<mới>>
}
package "ERD 02 — Danh mục và sản phẩm" {
  entity "categories" as categories
  entity "brands" as brands
  entity "products" as products
  entity "product_variants" as product_variants
  entity "product_images" as product_images
  entity "specifications" as specifications
}
package "ERD 03 — Nhà cung cấp và kho" {
  entity "suppliers" as suppliers
  entity "warehouses" as warehouses
  entity "goods_receipts" as goods_receipts
  entity "goods_receipt_items" as goods_receipt_items
  entity "goods_receipt_item_devices" as goods_receipt_item_devices <<mới>>
  entity "goods_receipt_item_device_imeis" as goods_receipt_item_device_imeis <<mới>>
  entity "inventory" as inventory
  entity "serial_numbers" as serial_numbers
  entity "imei" as imei
}
package "ERD 04 — Giỏ hàng và đơn hàng" {
  entity "carts" as carts
  entity "cart_items" as cart_items
  entity "orders" as orders
  entity "order_items" as order_items
  entity "payments" as payments
  entity "installment_payments" as installment_payments
  entity "installment_providers" as installment_providers
  entity "invoices" as invoices <<thiết kế sẵn>>
  entity "shipments" as shipments <<thiết kế sẵn>>
}
package "ERD 05 — Hậu mãi và chăm sóc khách hàng" {
  entity "warranties" as warranties
  entity "warranty_tickets" as warranty_tickets
  entity "promotions" as promotions
  entity "promotion_products" as promotion_products
  entity "reviews" as reviews <<thiết kế sẵn>>
  entity "return_requests" as return_requests <<thiết kế sẵn>>
  entity "return_items" as return_items <<thiết kế sẵn>>
}
package "ERD 06 — Chatbot và hội thoại" {
  entity "chat_sessions" as chat_sessions
  entity "chat_history" as chat_history
  entity "chatbot_qna" as chatbot_qna <<thiết kế sẵn>>
  entity "chatbot_scripts" as chatbot_scripts <<thiết kế sẵn>>
  entity "message_feedback" as message_feedback <<thiết kế sẵn>>
}
package "ERD 07 — Kho tri thức RAG và chỉ mục ngữ nghĩa" {
  entity "knowledge_documents" as knowledge_documents
  entity "knowledge_chunks" as knowledge_chunks
  entity "chat_message_retrievals" as chat_message_retrievals
  entity "product_semantic_index" as product_semantic_index <<mới>>
}

carts ||--o{ cart_items : cart_id
product_variants ||--o{ cart_items : variant_id
customers ||--o{ carts : customer_id
warehouses |o--o{ carts : warehouse_id
categories |o--o{ categories : parent_id
