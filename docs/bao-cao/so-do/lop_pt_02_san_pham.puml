@startuml
title So do lop muc phan tich - Phan he San pham
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam class {
  BackgroundColor<<phan he khac>> #F2F2F2
  BorderColor<<phan he khac>> #999999
  FontColor<<phan he khac>> #666666
}
hide <<phan he khac>> members

class DanhMuc {
  -tenDanhMuc : String
  -moTa : String
  -trangThai : TrangThaiKinhDoanh
  +themDanhMucCon(danhMuc : DanhMuc)
  +layDanhSachSanPham() : List<SanPham>
}

class ThuongHieu {
  -tenThuongHieu : String
  -moTa : String
  -trangThai : TrangThaiKinhDoanh
}

class SanPham {
  -tenSanPham : String
  -moTa : String
  -thoiGianBaoHanh : int
  -trangThai : TrangThaiKinhDoanh
  -ngayTao : Date
  +themPhienBan(phienBan : PhienBanSanPham)
  +themThongSo(ten : String, giaTri : String)
  +themHinhAnh(duongDan : String)
  +timKiem(tuKhoa : String) : List<SanPham>
}

class PhienBanSanPham {
  -maSKU : String
  -mauSac : String
  -ram : String
  -boNho : String
  -giaBan : double
  -giaNhap : double
  -cachTheoDoi : CachTheoDoi
  -trangThai : TrangThaiKinhDoanh
  +tinhGiaSauKhuyenMai() : double
  +kiemTraTonKho(kho : Kho) : int
}

class ThongSoKyThuat {
  -tenThongSo : String
  -giaTri : String
}

class HinhAnh {
  -duongDan : String
  -laAnhChinh : boolean
}

class KhuyenMai {
  -tenChuongTrinh : String
  -moTa : String
  -loaiGiam : LoaiGiamGia
  -giaTriGiam : double
  -ngayBatDau : Date
  -ngayKetThuc : Date
  -trangThai : TrangThaiKinhDoanh
  +apDung(sanPham : SanPham)
  +conHieuLuc() : boolean
  +tinhSoTienGiam(gia : double) : double
}

enum TrangThaiKinhDoanh {
  DangKinhDoanh
  NgungKinhDoanh
}

enum LoaiGiamGia {
  PhanTram
  SoTien
}

enum CachTheoDoi {
  KhongTheoDoi
  TheoSerial
  TheoIMEI
}

' Lop thuoc phan he khac, chi the hien lien ket
class Kho <<phan he khac>>
class TonKho <<phan he khac>>
class ThietBi <<phan he khac>>
class ChiTietPhieuNhap <<phan he khac>>
class ChiTietGioHang <<phan he khac>>
class ChiTietDonHang <<phan he khac>>
class DanhGia <<phan he khac>>

DanhMuc "0..1" -- "*" DanhMuc : danh muc cha
DanhMuc "1" -- "*" SanPham : phan loai
ThuongHieu "1" -- "*" SanPham : san xuat
SanPham "1" *-- "1..*" PhienBanSanPham
SanPham "1" *-- "*" ThongSoKyThuat
SanPham "1" *-- "*" HinhAnh
KhuyenMai "*" -- "*" SanPham : ap dung cho

PhienBanSanPham ..> CachTheoDoi
KhuyenMai ..> LoaiGiamGia
SanPham ..> TrangThaiKinhDoanh

PhienBanSanPham "1" -- "*" TonKho
PhienBanSanPham "1" -- "*" ThietBi
PhienBanSanPham "1" -- "*" ChiTietPhieuNhap
PhienBanSanPham "1" -- "*" ChiTietGioHang
PhienBanSanPham "1" -- "*" ChiTietDonHang
SanPham "1" -- "*" DanhGia
PhienBanSanPham ..> Kho

note right of PhienBanSanPham
  Moi phien ban la mot cau hinh
  cu the (mau, RAM, bo nho) co
  gia ban va ma SKU rieng.
  Hang theo Serial/IMEI duoc
  quan ly tung thiet bi.
end note

note bottom of KhuyenMai
  Khuyen mai ap dung cho san pham,
  moi phien ban cua san pham duoc
  giam nhu nhau.
  Gia sau khuyen mai = gia ban - so tien giam.
end note

note top of DanhMuc
  Danh muc co the co nhieu cap
  (vi du: Dien thoai > Smartphone).
end note
@enduml
