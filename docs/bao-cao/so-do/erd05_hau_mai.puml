@startuml
' ERD 05 — Hậu mãi và chăm sóc khách hàng — sinh tự động từ schema PostgreSQL (Flyway V1–V8), 7 bảng
hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor<<mới>> #E3F2FD
  BackgroundColor<<thiết kế sẵn>> #FFF3E0
  BackgroundColor<<tham chiếu>> #EEEEEE
}
title ERD 05 — Hậu mãi và chăm sóc khách hàng

entity "warranties" as warranties {
  * warranty_id : UUID <<PK>>
  --
  * serial_id : UUID <<FK>>
  * order_item_id : UUID <<FK>>
  * customer_id : UUID <<FK>>
  * start_date : DATE
  * end_date : DATE
  * status : VARCHAR
}

entity "warranty_tickets" as warranty_tickets {
  * ticket_id : UUID <<PK>>
  --
  * ticket_code : VARCHAR
  * warranty_id : UUID <<FK>>
  * serial_id : UUID <<FK>>
  * customer_id : UUID <<FK>>
    employee_id : UUID <<FK>>
  * issue_description : TEXT
    resolution_note : TEXT
  * created_at : TIMESTAMPTZ
    resolved_at : TIMESTAMPTZ
  * status : VARCHAR
}

entity "promotions" as promotions {
  * promotion_id : UUID <<PK>>
  --
  * promotion_name : VARCHAR
    description : TEXT
  * discount_type : VARCHAR
  * discount_value : DECIMAL
  * start_date : TIMESTAMPTZ
  * end_date : TIMESTAMPTZ
  * status : VARCHAR
}

entity "promotion_products" as promotion_products {
  * promotion_id : UUID <<PK,FK>>
  --
  * product_id : UUID <<PK,FK>>
}

entity "reviews" as reviews <<thiết kế sẵn>> {
  * review_id : UUID <<PK>>
  --
  * customer_id : UUID <<FK>>
  * product_id : UUID <<FK>>
  * order_item_id : UUID <<FK>>
    employee_id : UUID <<FK>>
  * rating : INT
    review_text : TEXT
    reply_text : TEXT
  * created_at : TIMESTAMPTZ
    replied_at : TIMESTAMPTZ
  * status : VARCHAR
}

entity "return_requests" as return_requests <<thiết kế sẵn>> {
  * return_id : UUID <<PK>>
  --
  * return_code : VARCHAR
  * order_id : UUID <<FK>>
  * customer_id : UUID <<FK>>
    employee_id : UUID <<FK>>
  * reason : TEXT
  * request_date : TIMESTAMPTZ
    processed_at : TIMESTAMPTZ
  * refund_amount : DECIMAL
  * status : VARCHAR
}

entity "return_items" as return_items <<thiết kế sẵn>> {
  * return_item_id : UUID <<PK>>
  --
  * return_id : UUID <<FK>>
  * order_item_id : UUID <<FK>>
    serial_id : UUID <<FK>>
  * quantity : INT
    reason : VARCHAR
}

entity "customers" as customers <<tham chiếu>> {
  * customer_id : UUID <<PK>>
}

entity "employees" as employees <<tham chiếu>> {
  * employee_id : UUID <<PK>>
}

entity "order_items" as order_items <<tham chiếu>> {
  * order_item_id : UUID <<PK>>
}

entity "orders" as orders <<tham chiếu>> {
  * order_id : UUID <<PK>>
}

entity "products" as products <<tham chiếu>> {
  * product_id : UUID <<PK>>
}

entity "serial_numbers" as serial_numbers <<tham chiếu>> {
  * serial_id : UUID <<PK>>
}

serial_numbers ||--o| warranties : serial_id
order_items ||--o{ warranties : order_item_id
customers ||--o{ warranties : customer_id
warranties ||--o{ warranty_tickets : warranty_id
serial_numbers ||--o{ warranty_tickets : serial_id
customers ||--o{ warranty_tickets : customer_id
employees |o--o{ warranty_tickets : employee_id
promotions ||--o{ promotion_products : promotion_id
products ||--o{ promotion_products : product_id
customers ||--o{ reviews : customer_id
products ||--o{ reviews : product_id
order_items ||--o{ reviews : order_item_id
employees |o--o{ reviews : employee_id
orders ||--o{ return_requests : order_id
customers ||--o{ return_requests : customer_id
employees |o--o{ return_requests : employee_id
serial_numbers |o--o{ return_items : serial_id
return_requests ||--o{ return_items : return_id
order_items ||--o{ return_items : order_item_id

legend right
  <<mới>>: bảng có trong CSDL, chưa có trong ERD báo cáo cũ
  <<thiết kế sẵn>>: bảng có trong CSDL, chưa có chức năng sử dụng
  <<tham chiếu>>: thực thể thuộc ERD khác
  * : NOT NULL
endlegend
@enduml
