APP_NAME=chatbot-service
APP_ENV=development

APP_HOST=0.0.0.0
APP_PORT=8090

BACKEND_BASE_URL=http://localhost:8080

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

CHAT_HISTORY_WINDOW=10
DEFAULT_TOP_K=5
# AI mode is opt-in; conversation authentication/persistence remains skeleton.
CHATBOT_AI_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=60
# Set explicitly to the status your team approves. PUBLISHED is a provisional default.
KNOWLEDGE_DOCUMENT_STATUS=PUBLISHED
# Existing PostgreSQL database with V1 schema + pgvector; no new migration needed.
# KNOWLEDGE_DATABASE_URL=postgresql://user:password@localhost:5432/database
